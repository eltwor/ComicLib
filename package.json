{
  "name": "comiclib",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:ui": "npm --prefix ui run build",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "app": "npm run build:ui && npm start"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
